# Friday Mahjong Scoreboard — local development environment
#
# Copy this file to `.env` (git-ignored) and fill in the "you must supply"
# section below. Then run `docker compose up`.
# Full guide: docs/local-development.md

# -----------------------------------------------------------------------
# Pre-filled — works out of the box for the Docker Compose stack. Change
# a port only if it collides with something else already running on your
# machine.
# -----------------------------------------------------------------------

# In-network Postgres connection string ("postgres" is the compose service
# name; this is unrelated to the host port below).
DATABASE_URL=postgresql://mahjong:mahjong@postgres:5432/mahjong

WEB_PORT=5173
API_PORT=5000
POSTGRES_HOST_PORT=5433
ADMINER_PORT=8080

# Consumed by the web app's Vite config.
BASE_PATH=/

# Guards the Vite dev-server proxy that unifies the browser's origin with
# the API's, so relative `/api/*` calls and Clerk's session cookie behave
# the same locally as they do behind Replit's router. Only the Docker
# Compose stack sets this — leave it as-is.
LOCAL_DEV_API_PROXY_TARGET=http://api:5000

# -----------------------------------------------------------------------
# You must supply — from a Clerk *development* instance. See
# docs/local-development.md#obtaining-clerk-keys for how to get these.
# -----------------------------------------------------------------------

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Comma-separated admin allowlists — set both to your own Google account
# email so you can sign in and exercise admin create/edit/delete locally.
ADMIN_EMAILS=
VITE_ADMIN_EMAILS=

# -----------------------------------------------------------------------
# Placeholders — only exist to satisfy the API server's startup validation.
# The Gemini integration is imported eagerly and throws at boot if these
# are absent, regardless of whether chip scanning is used. With
# placeholders the server boots fine; chip scanning itself will fail at
# call time with an authentication error. This is a known local
# limitation, not a bug — see docs/local-development.md.
# -----------------------------------------------------------------------

AI_INTEGRATIONS_GEMINI_BASE_URL=https://localhost.invalid/not-a-real-endpoint
AI_INTEGRATIONS_GEMINI_API_KEY=local-placeholder-not-a-real-key
